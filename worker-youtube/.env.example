# Copy this file to .env on EACH worker machine and fill in the values.
#   Windows:  copy .env.example .env
#   Mac:      cp .env.example .env

# Master node LAN IP (Hadoop NameNode + Spark Master)
MASTER_IP=10.77.120.200

# THIS worker machine's own LAN IP
#   Windows: ipconfig  -> "IPv4 Address" under Wi-Fi/Ethernet
#   Mac:     ipconfig getifaddr en0
WORKER_IP=10.77.120.170

# HDFS data port - MUST be different on every worker.
#   Worker 1: 9866   Worker 2: 9876   Worker 3: 9886 ...
# Never use 9867 (it is the DataNode's internal IPC port).
DATANODE_PORT=9866
